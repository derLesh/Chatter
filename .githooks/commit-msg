#!/bin/sh
# Checks the commit message against the convention in AGENTS.md. Turn it on once per clone:
#   git config core.hooksPath .githooks
# Windows may have a python3 that only opens the Store, so each candidate must actually run.
for python in python3 python "py -3"; do
  if $python -c '' > /dev/null 2>&1; then
    exec $python -I "$(git rev-parse --show-toplevel)/.github/scripts/check-commits.py" message "$1"
  fi
done
echo "commit-msg: no Python found, so the message was not checked." >&2
