# Chatter in the background with the screen off: 30 minutes with a busy channel
# joined. Records how often the app's threads wake up and run, the wakelocks,
# when the phone sleeps, the packets sent and received, and what each power
# rail draws. The recipe and the queries are in docs/power.md.
duration_ms: 1800000

# 0: scheduler and wakelocks, the bulk of it. 1: counters, packets, packages.
buffers {
  size_kb: 65536
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 16384
  fill_policy: RING_BUFFER
}

# Written out as it goes: half an hour of scheduler events does not fit in RAM.
write_into_file: true
file_write_period_ms: 2500
flush_period_ms: 30000
max_file_size_bytes: 1000000000

data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "sched/sched_wakeup_new"
      ftrace_events: "sched/sched_process_exit"
      ftrace_events: "sched/sched_process_free"
      ftrace_events: "task/task_newtask"
      ftrace_events: "task/task_rename"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      ftrace_events: "power/suspend_resume"
      ftrace_events: "power/wakeup_source_activate"
      ftrace_events: "power/wakeup_source_deactivate"
      # Wakelocks by tag, as system_server sees them.
      atrace_categories: "power"
      symbolize_ksyms: false
    }
  }
}

data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config {
      scan_all_processes_on_start: true
      proc_stats_poll_ms: 60000
    }
  }
}

data_sources {
  config {
    name: "android.power"
    target_buffer: 1
    android_power_config {
      battery_poll_ms: 1000
      battery_counters: BATTERY_COUNTER_CHARGE
      battery_counters: BATTERY_COUNTER_CURRENT
      collect_power_rails: true
    }
  }
}

# Every packet with its app and time: when the radio had to be up and for whom.
data_sources {
  config {
    name: "android.network_packets"
    target_buffer: 1
    network_packet_trace_config {
      poll_ms: 250
    }
  }
}

data_sources {
  config {
    name: "android.packages_list"
    target_buffer: 1
  }
}
