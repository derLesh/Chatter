<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".ChatterApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Chatter">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!--
            The chat bubble. Android hosts it in its own floating window, which is what the three
            attributes below are for: embeddable, resizeable, and one document per channel so two
            channels can bubble next to each other.
        -->
        <activity
            android:name=".ui.bubble.BubbleActivity"
            android:allowEmbedded="true"
            android:documentLaunchMode="always"
            android:exported="false"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Launcher entries, one per app icon. Exactly one is enabled (see AppIcon.kt). -->
        <activity-alias
            android:name=".LauncherLight"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Takes the text typed into the reply action of a mention notification. -->
        <receiver
            android:name=".service.ReplyReceiver"
            android:exported="false" />

        <service
            android:name=".service.ChatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!--
                Google reads this value when it reviews the specialUse declaration, so it says why
                no other type fits: there is no push to fall back on. The form in the Play Console
                carries the longer version of the same argument.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds the user's own Twitch chat session open (IRC over WebSocket) so that mentions and whispers addressed to them can be delivered as notifications the moment they arrive. Twitch publishes no push API for chat messages, so there is no FCM path to this data and the connection is the only source. The service is started by the user joining a channel, runs only while they have channels joined, and stops when they leave or log out. No other foregroundServiceType describes an interactive chat session: it is not media, location, data transfer, or device sync." />
        </service>
    </application>
</manifest>
