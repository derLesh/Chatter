<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing of Chatter goes into a cloud backup. Setting up a new phone from the old one takes the
    settings and the channels along, and nothing else.

    allowBackup="false" in the manifest only ever covered the cloud: since Android 12 a transfer
    from one phone to the next ignores it and takes what is listed here. The login could not be
    read there anyway, since its key is in the old phone's Keystore. The inboxes, statistics and
    crash reports stay behind; nicknames and rules move with the file saved under Settings → Backup.
    docs/privacy-policy.html says so; it changes with this file.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <!-- With an include, only what is included moves. The names are the preference stores in
         AppContainer. -->
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/channels.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
